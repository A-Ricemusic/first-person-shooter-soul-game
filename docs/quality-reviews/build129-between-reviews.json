    "sha256": "7f8e3bae6adc76de20801ed3573544f77644fe8a8727613dcb324571e56a5078",
    "overallMobile": 7.2,
    "outcomes": [
      "WIN / SIGNAL RESTORED",
      "WIN / SIGNAL RESTORED"
    ],
    "originalScores": {
      "scale": "0 unusable; 5 functional with substantial friction; 7 good with clear remaining friction; 9 excellent in assessed scope; 10 exceptional. Subjective holistic evaluation of these two synthetic paused mobile runs, not a win/loss grade or arithmetic average.",
      "overall_mobile": 7.2,
      "controls": {
        "score": 7,
        "reason": "Large separated controls, tap aim, MOVE/FIRE drag, scene swipe and DASH all responded. Target acquisition near cover needed correction; unaided precision, continuous holds and real thumb ergonomics remain unassessed."
      },
      "gameplay": {
        "score": 7,
        "reason": "Recovery, patrols, armor openings and deck defense supplied distinct observed tasks with legible feedback. Assisted navigation reduced exploration burden and most of this review used it; short paused runs do not establish sustained enjoyment or challenge balance."
      },
      "presentation": {
        "score": 8,
        "reason": "Cohesive rainy station, teal/gold signals, illuminated machinery and restrained result screen convey a strong atmosphere in still captures. Audio and real-time hardware smoothness unassessed."
      },
      "usability": {
        "score": 8,
        "reason": "Context action labels, named checkmarks, threat TURN prompts, map route and explicit START FRESH made progression understandable without source knowledge. Facing/target changes require fresh orientation and many simultaneous cues compete."
      },
      "readability": {
        "score": 6.5,
        "reason": "Health/ammo, objectives and action pads are readable at 844x390; small distant guards, low-contrast gray geometry, compact compass/announcement text and overlapping world labels demand inspection."
      }
    }
  },
